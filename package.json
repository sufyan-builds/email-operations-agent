{
  "name": "email-operations-agent",
  "version": "1.0.0",
  "description": "HazelJS Agent OS email operations agent: classify, extract intent, policy-gate, approve, simulate.",
  "private": true,
  "license": "MIT",
  "author": "Muhammad Sufyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sufyan-builds/email-operations-agent.git"
  },
  "keywords": [
    "hazeljs",
    "autonomous",
    "ai-agent",
    "email",
    "human-in-the-loop",
    "policy-gate",
    "prompt-injection",
    "typescript"
  ],
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "demo": "tsx src/index.ts --approve",
    "demo:reject": "tsx src/index.ts --reject",
    "demo:autonomous": "tsx src/autonomous/demo-autonomous.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hazeljs/agent": "^2.0.16",
    "@hazeljs/agent-gatekeeper": "^2.0.16",
    "@hazeljs/autonomous": "^2.0.16",
    "@hazeljs/core": "^2.0.16",
    "@hazeljs/eval": "^2.0.16",
    "@hazeljs/rag": "^2.0.16",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
